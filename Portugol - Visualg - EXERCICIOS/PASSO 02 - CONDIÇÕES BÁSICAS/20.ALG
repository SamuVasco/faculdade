Algoritmo "20"
// Autor(a)    : Samuel Souza
// Data atual  : 04/08/2026
// 20) Desenvolva um programa que leia um número inteiro e mostre se ele é PAR ou
// ÍMPAR.

Var
   num: Inteiro


Inicio
 Escreva("Digite um número INTEIRO: ")
 Leia(num)
 Se (num % 2 = 0) entao
    Escreva(num, " É PAR")
 senao
    Escreva(num, " É ÍMPAR")
 FimSe


Fimalgoritmo